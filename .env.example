# Browser-safe values from the NEW Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy compatibility only if the new secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# At least 32 random bytes, used to derive public capability tokens and hashes.
TYAMA_TOKEN_PEPPER=

# Optional server settings.
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_FAST=
TYAMA_ENV=development
